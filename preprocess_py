# ------------------------------------------------------------------
#  Simple helper functions
# ------------------------------------------------------------------

def _split_masks(n: int, train: float = 0.6, val: float = 0.2):
    idx = torch.randperm(n)
    tr, va = int(train * n), int(val * n)
    m_tr, m_va, m_te = torch.zeros(n, dtype=torch.bool), torch.zeros(n, dtype=torch.bool), torch.zeros(n, dtype=torch.bool)
    m_tr[idx[:tr]] = True
    m_va[idx[tr : tr + va]] = True
    m_te[idx[tr + va :]] = True
    return m_tr, m_va, m_te


def _add_edge_curvature(edge_index: torch.Tensor) -> torch.Tensor:
    deg = torch.bincount(edge_index[0])
    curv = 1.0 - (deg[edge_index[0]] + deg[edge_index[1]]) / 20.0
    curv = torch.clamp(curv, -1.0, 1.0)
    return curv.float()


# ------------------------------------------------------------------
#  Dataset loaders
# ------------------------------------------------------------------

class CoraWithCurvature(InMemoryDataset):
    def __init__(self, root: str):
        super().__init__(root)
        self.data, self.slices = torch.load(self.processed_paths[0])

    @property
    def processed_file_names(self):
        return ["cora.pt"]

    def download(self):  # pragma: no cover
        pass

    def process(self):
        data = Planetoid(self.root, "Cora")[0]
        data.edge_attr = _add_edge_curvature(data.edge_index)
        data.train_mask, data.val_mask, data.test_mask = _split_masks(data.x.size(0))
        torch.save(self.collate([data]), self.processed_paths[0])


def _load_cora(root: Path):
    return CoraWithCurvature(str(root / "cora"))[0]


def _load_ogbn_arxiv(root: Path):
    ds = NodePropPredDataset("ogbn-arxiv", root=str(root))
    g, y = ds[0]
    data = Data(
        x=torch.from_numpy(g["node_feat"]).float(),
        edge_index=torch.from_numpy(g["edge_index"]),
        y=torch.from_numpy(y).squeeze().long(),
    )
    split = ds.get_idx_split()
    n = data.x.size(0)
    data.train_mask, data.val_mask, data.test_mask = (
        torch.zeros(n, dtype=torch.bool),
        torch.zeros(n, dtype=torch.bool),
        torch.zeros(n, dtype=torch.bool),
    )
    data.train_mask[split["train"]] = True
    data.val_mask[split["valid"]] = True
    data.test_mask[split["test"]] = True
    data.edge_index = to_undirected(data.edge_index)
    data.edge_attr = _add_edge_curvature(data.edge_index)
    return data


def load_dataset(name: str, root: str = "./data"):
    root_path = Path(root)
    root_path.mkdir(parents=True, exist_ok=True)
    if name == "cora":
        return _load_cora(root_path)
    if name == "ogbn-arxiv":
        return _load_ogbn_arxiv(root_path / "ogb")
    raise ValueError(f"unknown dataset {name}")


# Temporal helper­ – for smoke test we just replicate static graph

def prepare_temporal_data(name: str, root: str = "./data", snapshots: int = 6) -> List[Data]:
    base = load_dataset(name, root)
    outs = []
    for t in range(snapshots):
        d = base.clone()
        d.snapshot_id = t
        outs.append(d)
    return outs
