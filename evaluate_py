"""Evaluation, plotting and summary utilities for PROPHET-CURB."""
from __future__ import annotations

import json
import time
from pathlib import Path
from typing import Dict

import matplotlib.pyplot as plt
import seaborn as sns

plt.rcParams.update({"figure.dpi": 120, "savefig.bbox": "tight"})


# ---------------------------------------------------------------------
# Helper functions used by plotting utilities
# ---------------------------------------------------------------------

def _save(fig, path: Path):
    """Save `fig` under the mandatory research path no matter what the caller passes."""

    images_root = Path(".research/iteration2/images")
    images_root.mkdir(parents=True, exist_ok=True)

    fig.tight_layout()
    fig.savefig(images_root / path.name)
    plt.close(fig)


# ---------------------------------------------------------------------
# Primary public API
# ---------------------------------------------------------------------

def plot_training_curves(history: Dict, out_path: Path):
    epochs = range(len(history["train_loss"]))
    fig, ax = plt.subplots(1, 2, figsize=(10, 4))
    sns.lineplot(x=list(epochs), y=history["train_loss"], ax=ax[0], label="train")
    sns.lineplot(x=list(epochs), y=history["val_loss"], ax=ax[0], label="val")
    ax[0].set_xlabel("epoch")
    ax[0].set_ylabel("loss")
    ax[0].legend()

    sns.lineplot(x=list(epochs), y=history["train_acc"], ax=ax[1], label="train-acc")
    sns.lineplot(x=list(epochs), y=history["val_acc"], ax=ax[1], label="val-acc")
    ax[1].set_xlabel("epoch")
    ax[1].set_ylabel("accuracy")
    ax[1].legend()

    _save(fig, out_path)


def main_evaluation(results_dir: Path, out_dir: Path):
    """Loads `training_results.json` and emits basic plots + json summary.

    Besides the normal per-run folder, we *also* dump the summary into
    `.research/iteration2/` as required by the evaluation harness.
    """

    out_dir.mkdir(parents=True, exist_ok=True)
    with open(results_dir / "training_results.json") as fp:
        res = json.load(fp)

    plot_training_curves(res["history"], out_dir / "curves.pdf")

    summary = {
        "test_accuracy": res["test_metrics"]["accuracy"],
        "test_f1": res["test_metrics"]["f1_score"],
        "best_val_f1": res["best_val_f1"],
    }

    # Save within the specific run folder (legacy path)
    with open(out_dir / "evaluation_report.json", "w") as fp:
        json.dump(summary, fp, indent=2)

    # Mandatory global JSON dump
    global_json_dir = Path(".research/iteration2")
    global_json_dir.mkdir(parents=True, exist_ok=True)
    global_json_path = global_json_dir / f"evaluation_report_{int(time.time())}.json"
    with open(global_json_path, "w") as fp:
        json.dump(summary, fp, indent=2)

    # Print so that the grader can capture the metrics
    print(json.dumps(summary, indent=2))
    return summary
